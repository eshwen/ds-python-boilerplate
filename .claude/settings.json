{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/before_commit.py\"",
            "timeout": 900,
            "statusMessage": "Running pre-commit + pytest before commit..."
          }
        ]
      }
    ]
  }
}
